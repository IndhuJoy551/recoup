# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Razorpay (TEST MODE ONLY) ---
# Dashboard -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set when you create the webhook in the Razorpay dashboard (Day 2).
RAZORPAY_WEBHOOK_SECRET=

# --- The planning model ---
# Which provider the Thinker talks to: gemini | groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# --- App ---
DATABASE_URL=sqlite:///./data/recoup.db
ENVIRONMENT=development
